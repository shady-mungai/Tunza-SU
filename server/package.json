    "url": "https://github.com/shady-mungai/Tunza-SU/issues"
  },
  "homepage": "https://github.com/shady-mungai/Tunza-SU#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@sentry/node": "^11.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "file-type": "^22.3.0",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
