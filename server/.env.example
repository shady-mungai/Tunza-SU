NODE_ENV=development
PORT=4000
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=tunza-su-api
JWT_AUDIENCE=tunza-su-mobile
ACCESS_TOKEN_TTL=8h

# Comma-separated OAuth client IDs that may issue Google ID tokens to the API.
GOOGLE_CLIENT_IDS=
# Set this to require organization-managed accounts, for example strathmore.edu.
GOOGLE_HOSTED_DOMAIN=

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Use local for development. Use s3 for production or multiple API instances.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# Optional for S3-compatible providers such as Cloudflare R2 or MinIO.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=reports
# Optional CDN/public URL. If blank, the API returns short-lived signed URLs.
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL_SECONDS=900

# Backend-owned email delivery. Leave SMTP_HOST blank to disable notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFICATION_ADMIN_EMAILS=

# Optional crash reporting and request tracing. Leave SENTRY_DSN blank to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
RELEASE_VERSION=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tunza_su
MYSQL_USER=tunza_app
MYSQL_PASSWORD=replace-me

# Used only by `npm run create-admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_ADMISSION_NUMBER=
ADMIN_PHONE_NUMBER=
ADMIN_PASSWORD=
