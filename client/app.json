{
  "expo": {
    "scheme": "tunzasu",
    "name": "Tunza SU",
    "slug": "tunza-su",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tunzasu.app"
    },
    "android": {
      "package": "com.tunzasu.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tunza SU to attach photos to maintenance reports.",
          "cameraPermission": "Allow Tunza SU to take photos for maintenance reports."
        }
      ]
    ]
  }
}
