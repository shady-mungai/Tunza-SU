# Use an HTTPS URL in staging and production.
# For a physical device in local development, use your computer's LAN address.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Dynamic app configuration. EAS injects preview/production values remotely.
APP_VARIANT=development
EAS_PROJECT_ID=
EXPO_OWNER=

# OAuth client identifiers are safe to expose to the app, but should still be
# configured per environment rather than committed as live project values.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional crash reporting. The DSN is designed to be public; never expose a
# Sentry auth token or another server-side credential through EXPO_PUBLIC_*.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
