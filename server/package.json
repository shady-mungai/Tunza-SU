{
  "name": "tunza-su",
  "version": "1.0.0",
  "description": "A mobile based solution to streamline the reporting of faulty infrastructure in Strathmore University",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/createApp.js && node --check src/services/storage.js && node --check src/services/notifier.js && node --check src/services/observability.js && node --check scripts/migrate.js && node --check scripts/createAdmin.js && node --test",
    "test": "node --test",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/createAdmin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shady-mungai/Tunza-SU.git"
  },
