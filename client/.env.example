# Use an HTTPS URL in staging and production.
# For a physical device in local development, use your computer's LAN address.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# OAuth client identifiers are safe to expose to the app, but should still be
# configured per environment rather than committed as live project values.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Temporary client-side email configuration. Phase 2 will move notifications
# to the authenticated backend.
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_NEW_REPORT_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_RESOLVED_REPORT_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
